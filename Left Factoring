#include <iostream>
#include <fstream>
#include <vector>
#include <string>
using namespace std;

string strip(string s) {
    string r;
    for(char c : s) if(c!=' ' && c!='\t') r += c;
    return r;
}

int main() {
    ifstream f("grammar.txt");
    if(!f) { cout << "cannot open grammar.txt\n"; return 1; }

    string line;
    while(getline(f, line)) {
        size_t x = line.find("->");
        if(x == string::npos) continue;

        string L = strip(line.substr(0, x));
        string rhs = line.substr(x + 2);

        vector<string> P;
        int start = 0;
        for(int i = 0; i <= (int)rhs.size(); i++) {
            if(i == (int)rhs.size() || rhs[i] == '|') {
                P.push_back(strip(rhs.substr(start, i - start)));
                start = i + 1;
            }
        }

        cout << L << " -> ";
        for(int i = 0; i < (int)P.size(); i++)
            cout << (i ? "|" : "") << P[i];
        cout << "\n";

        if(P.size() < 2) { cout << "No factoring\n\n"; continue; }

        // Find longest prefix shared by ANY two alternatives
        string bestPre = "";
        for(int a = 0; a < (int)P.size(); a++) {
            for(int b = a + 1; b < (int)P.size(); b++) {
                int k = 0;
                while(k < (int)P[a].size() && k < (int)P[b].size()
                      && P[a][k] == P[b][k]) k++;
                if(k > 0 && k > (int)bestPre.size())
                    bestPre = P[a].substr(0, k);
            }
        }

        if(bestPre.empty()) { cout << "No factoring\n\n"; continue; }

        // Group alternatives that start with bestPre vs the rest
        vector<string> groupFac, groupRest;
        for(auto &alt : P) {
            if(alt.compare(0, bestPre.size(), bestPre) == 0)
                groupFac.push_back(alt.substr(bestPre.size()));
            else
                groupRest.push_back(alt);
        }

        // Emit:  L -> pre L' | rest...
        cout << L << " -> " << bestPre << L << "'";
        for(auto &g : groupRest) cout << "|" << g;
        cout << "\n";

        cout << L << "' -> ";
        for(int i = 0; i < (int)groupFac.size(); i++)
            cout << (i ? "|" : "") << (groupFac[i].empty() ? "ε" : groupFac[i]);
        cout << "\n\n";
    }
}
