#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <set>
#include <map>
#include <cctype>
using namespace std;

// Trim leading/trailing whitespace
string trim(const string &s) {
    size_t a = s.find_first_not_of(" \t\r\n");
    if (a == string::npos) return "";
    size_t b = s.find_last_not_of(" \t\r\n");
    return s.substr(a, b - a + 1);
}

int main() {
    ifstream f("grammar.txt");
    if (!f) { cout << "File not found!\n"; return 1; }

    vector<string> ntList;                          // ordered list of nonterminals
    set<string> nonterminals;                       // fast lookup
    vector<pair<string, string>> rawRules;          // (LHS, RHS-string), in order
    map<string, vector<vector<string>>> grammar;    // NT -> list of token sequences

    string line;

    // ---------- PASS 1: collect nonterminals ----------
    while (getline(f, line)) {
        size_t arrow = line.find("->");
        if (arrow == string::npos) continue;

        string L = trim(line.substr(0, arrow));
        string rhs = line.substr(arrow + 2);

        rawRules.push_back({L, rhs});

        if (nonterminals.find(L) == nonterminals.end()) {
            nonterminals.insert(L);
            ntList.push_back(L);
        }
    }

    // ---------- PASS 2: tokenize RHS ----------
    for (auto &pr : rawRules) {
        const string &L = pr.first;
        const string &rhs = pr.second;

        size_t start = 0;
        for (size_t i = 0; i <= rhs.size(); i++) {
            if (i == rhs.size() || rhs[i] == '|') {
                string alt = trim(rhs.substr(start, i - start));
                start = i + 1;

                vector<string> tokens;

                // Empty alternative or explicit epsilon symbol
                if (alt.empty() || alt == "ε" || alt == "eps" || alt == "@" || alt == "lambda") {
                    tokens.push_back("ε");
                } else {
                    size_t p = 0;
                    while (p < alt.size()) {
                        // skip whitespace
                        if (isspace((unsigned char)alt[p])) { p++; continue; }

                        // try longest match against known nonterminals
                        string best = "";
                        for (auto &n : ntList) {
                            if (alt.compare(p, n.size(), n) == 0 && n.size() > best.size())
                                best = n;
                        }

                        if (!best.empty()) {
                            tokens.push_back(best);
                            p += best.size();
                        }
                        else if (isalpha((unsigned char)alt[p]) || alt[p] == '_') {
                            // multi-char identifier terminal (id, num, true, ...)
                            string tok;
                            while (p < alt.size() &&
                                   (isalnum((unsigned char)alt[p]) || alt[p] == '_'))
                                tok += alt[p++];
                            tokens.push_back(tok);
                        }
                        else {
                            // single-char punctuation terminal (+, *, (, ), ...)
                            tokens.push_back(string(1, alt[p]));
                            p++;
                        }
                    }
                }
                grammar[L].push_back(tokens);
            }
        }
    }

    // ---------- Compute FIRST sets ----------
    map<string, set<string>> FIRST;
    for (auto &n : ntList) FIRST[n] = {};

    bool changed = true;
    while (changed) {
        changed = false;

        for (auto &n : ntList) {
            for (auto &prod : grammar[n]) {
                bool allNullable = true;

                for (auto &sym : prod) {
                    if (sym == "ε") {
                        continue;
                    }
                    else if (nonterminals.count(sym)) {
                        // nonterminal: add FIRST(sym) \ {ε}
                        for (auto &x : FIRST[sym]) {
                            if (x != "ε" && !FIRST[n].count(x)) {
                                FIRST[n].insert(x);
                                changed = true;
                            }
                        }
                        // if sym cannot derive ε, stop scanning this production
                        if (!FIRST[sym].count("ε")) {
                            allNullable = false;
                            break;
                        }
                    }
                    else {
                        // terminal: add it and stop
                        if (!FIRST[n].count(sym)) {
                            FIRST[n].insert(sym);
                            changed = true;
                        }
                        allNullable = false;
                        break;
                    }
                }

                // If every symbol in the production is nullable, add ε
                if (allNullable && !FIRST[n].count("ε")) {
                    FIRST[n].insert("ε");
                    changed = true;
                }
            }
        }
    }

    // ---------- Print FIRST sets (real ε) ----------
    cout << "FIRST sets:\n";
    for (auto &n : ntList) {
        cout << "FIRST(" << n << ") = {";
        bool firstItem = true;
        for (auto &x : FIRST[n]) {
            cout << (firstItem ? " " : ", ");
            cout << x;                       // prints ε directly
            firstItem = false;
        }
        cout << (firstItem ? "" : " ") << "}\n";
    }

    return 0;
}
