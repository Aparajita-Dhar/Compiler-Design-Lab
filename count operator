#include <iostream>
#include <fstream>
#include <string>

using namespace std;

// Single-character operators
bool isOperator(char c) {
    return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' ||
           c == '=' || c == '<' || c == '>' || c == '!' || c == '&' ||
           c == '|' || c == '^' || c == '~';
}

// Two-character operators (checked first, before single-char)
bool isTwoCharOp(const string& s, size_t i) {
    if (i + 1 >= s.length()) return false;
    string two = s.substr(i, 2);
    return two == "==" || two == "!=" || two == "<=" || two == ">=" ||
           two == "&&" || two == "||" || two == "++" || two == "--" ||
           two == "+=" || two == "-=" || two == "*=" || two == "/=" ||
           two == "%=" || two == "<<" || two == ">>" || two == "->";
}

int main() {
    ifstream f("input.txt");
    if (!f) {
        cerr << "File not found!\n";
        return 1;
    }

    string s;
    int total = 0;

    while (getline(f, s)) {
        int count = 0;
        cout << "Expression: " << s << "\nOperators found: ";

        for (size_t i = 0; i < s.length(); ++i) {
            if (isTwoCharOp(s, i)) {
                cout << s[i] << s[i + 1] << " ";
                ++i;              // consume second char
                ++count;
                continue;
            }
            if (isOperator(s[i])) {
                cout << s[i] << " ";
                ++count;
            }
        }

        if (count == 0) cout << "None";
        cout << " (" << count << " operators)\n";
        total += count;
    }

    cout << "\nTotal operators in file: " << total << "\n";
    return 0;
}
